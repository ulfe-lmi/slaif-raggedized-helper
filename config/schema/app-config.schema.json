{
  "$defs": {
    "DegradationPolicy": {
      "additionalProperties": false,
      "description": "Explicit degradation: disabled by default; when enabled it must name the\nallowed fallback steps. Implicit degradation is a configuration error.",
      "properties": {
        "allow": {
          "items": {
            "$ref": "#/$defs/DegradationStep"
          },
          "title": "Allow",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "DegradationPolicy",
      "type": "object"
    },
    "DegradationStep": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DegradationStep",
      "type": "object"
    },
    "Device": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "Device",
      "type": "string"
    },
    "DirectCapabilities": {
      "additionalProperties": false,
      "description": "Tested native /completion capabilities of the private llama build.\n\n``cache_prompt``/slot selection enter the wire envelope only when the\ncapability was actually tested on that build (architecture A13: native\ncache_prompt/id_slot only on tested builds).",
      "properties": {
        "cache_prompt_tested": {
          "default": false,
          "title": "Cache Prompt Tested",
          "type": "boolean"
        },
        "slot_tested": {
          "default": false,
          "title": "Slot Tested",
          "type": "boolean"
        }
      },
      "title": "DirectCapabilities",
      "type": "object"
    },
    "DirectDestination": {
      "additionalProperties": false,
      "description": "Private trusted /completion destination (never a public caller choice).\n\nPrivate IP/localhost alone is not access-control proof: enabling direct\nmode additionally requires the explicit ``private_trusted`` policy\ndeclaration on :class:`DirectGenerationConfig`.",
      "properties": {
        "base_url": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "base_url"
      ],
      "title": "DirectDestination",
      "type": "object"
    },
    "DirectGenerationConfig": {
      "additionalProperties": false,
      "description": "Direct (non-gateway) generation.\n\nOnline direct generation is unconditionally refused: the ``enabled``\nguard from the foundation slice is retained and no online direct mode\nexists. ``mode: offline_diagnostic`` is the narrow explicit offline\nopt-in for context-annotation/visual-extraction diagnostics against a\nprivate trusted destination; it is never an answer fallback.",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/DirectCapabilities"
        },
        "chat_template": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Template"
        },
        "deadline_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline Seconds"
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectDestination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_retries": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "offline_diagnostic"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "slot_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        },
        "template_qualification": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectTemplateQualification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trusted_policy": {
          "anyOf": [
            {
              "const": "private_trusted",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trusted Policy"
        }
      },
      "title": "DirectGenerationConfig",
      "type": "object"
    },
    "DirectTemplateQualification": {
      "additionalProperties": false,
      "description": "Explicit qualification record binding a chat template to a build.\n\nThe template name alone never proves qualification: offline direct\nmode requires this record, produced by ``POST /apply-template`` against\nthe tested build or by pinned-upstream verification of the exact\nbuilt-in template rendering.",
      "properties": {
        "build_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Build Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "apply-template",
            "pinned-upstream"
          ],
          "title": "Method",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "template": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "required": [
        "build_id",
        "method",
        "recorded_at"
      ],
      "title": "DirectTemplateQualification",
      "type": "object"
    },
    "Dtype": {
      "enum": [
        "fp32",
        "fp16"
      ],
      "title": "Dtype",
      "type": "string"
    },
    "EmbeddingPolicy": {
      "additionalProperties": false,
      "description": "Exclusive offline embedding policy: offline embedding runs on an\nexclusive GPU (FP16 or qualified FP32 compute) and stores normalized FP32\nvectors (architecture A16: stored vectors are always FP32).",
      "properties": {
        "exclusive_offline_gpu": {
          "default": true,
          "title": "Exclusive Offline Gpu",
          "type": "boolean"
        },
        "store_dtype": {
          "$ref": "#/$defs/Dtype",
          "default": "fp32"
        }
      },
      "title": "EmbeddingPolicy",
      "type": "object"
    },
    "GeneratorConfig": {
      "additionalProperties": false,
      "description": "Online generation through the configured gateway route only.",
      "properties": {
        "api_key_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Ref"
        },
        "context_expected_tokens": {
          "exclusiveMinimum": 0,
          "title": "Context Expected Tokens",
          "type": "integer"
        },
        "deadline_seconds": {
          "title": "Deadline Seconds",
          "type": "number"
        },
        "degradation": {
          "$ref": "#/$defs/DegradationPolicy"
        },
        "fallback": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback"
        },
        "max_inflight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Max Inflight",
          "type": "integer"
        },
        "max_retries": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "output_reserve_tokens": {
          "exclusiveMinimum": 0,
          "title": "Output Reserve Tokens",
          "type": "integer"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "context_expected_tokens",
        "output_reserve_tokens",
        "deadline_seconds"
      ],
      "title": "GeneratorConfig",
      "type": "object"
    },
    "ModelLockRef": {
      "additionalProperties": false,
      "description": "Reference to a model lock/manifest file inspected by ``doctor``.",
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "generator",
            "embedding",
            "reranker"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path"
      ],
      "title": "ModelLockRef",
      "type": "object"
    },
    "ProfileConfig": {
      "additionalProperties": false,
      "description": "One named serving profile with an explicit purpose/device/dtype shape.",
      "properties": {
        "device": {
          "$ref": "#/$defs/Device"
        },
        "dtype": {
          "$ref": "#/$defs/Dtype"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ProfilePurpose"
        }
      },
      "required": [
        "name",
        "purpose",
        "device",
        "dtype"
      ],
      "title": "ProfileConfig",
      "type": "object"
    },
    "ProfilePurpose": {
      "enum": [
        "online_query_embedding",
        "online_rerank",
        "offline_embed",
        "offline_context"
      ],
      "title": "ProfilePurpose",
      "type": "string"
    },
    "RouteCapabilities": {
      "additionalProperties": false,
      "description": "Explicit transport capabilities advertised by the configured route.\n\nEverything is default-deny: an optional control (streaming, vision,\nstructured output, prompt caching) is usable only when its route\ncapability is explicitly declared here (architecture A13/A18: no JSON/\nstream/vision/cache support is guessed).",
      "properties": {
        "json_mode": {
          "default": false,
          "title": "Json Mode",
          "type": "boolean"
        },
        "prompt_caching": {
          "default": false,
          "title": "Prompt Caching",
          "type": "boolean"
        },
        "stored_responses": {
          "default": false,
          "title": "Stored Responses",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        },
        "structured_outputs": {
          "default": false,
          "title": "Structured Outputs",
          "type": "boolean"
        },
        "vision": {
          "default": false,
          "title": "Vision",
          "type": "boolean"
        }
      },
      "title": "RouteCapabilities",
      "type": "object"
    },
    "RouteConfig": {
      "additionalProperties": false,
      "description": "Explicit gateway route contract reference (never guessed).",
      "properties": {
        "api": {
          "const": "v1-responses",
          "default": "v1-responses",
          "title": "Api",
          "type": "string"
        },
        "base_url": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/RouteCapabilities"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "timeout_seconds": {
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "base_url",
        "model",
        "timeout_seconds"
      ],
      "title": "RouteConfig",
      "type": "object"
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "A secret *name* or secret-file reference. Never a raw secret value.",
      "properties": {
        "kind": {
          "enum": [
            "env",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "SecretRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level strict configuration loaded by ``raggedized doctor``.",
  "properties": {
    "direct_generation": {
      "$ref": "#/$defs/DirectGenerationConfig"
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingPolicy"
    },
    "generator": {
      "$ref": "#/$defs/GeneratorConfig"
    },
    "model_locks": {
      "items": {
        "$ref": "#/$defs/ModelLockRef"
      },
      "title": "Model Locks",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ProfileConfig"
      },
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secrets": {
      "additionalProperties": {
        "$ref": "#/$defs/SecretRef"
      },
      "title": "Secrets",
      "type": "object"
    }
  },
  "required": [
    "generator"
  ],
  "title": "RaggedizedConfig",
  "type": "object"
}
